{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["../../assets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "svg.d.ts"
  ]
}
